{
  "name": "wiki",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm validate:code-fences && docusaurus build && pnpm export:llms && pnpm validate:llms",
    "build:en": "pnpm validate:code-fences && docusaurus build --locale en && pnpm export:llms && pnpm validate:llms",
    "clean": "node -e \"const fs = require('node:fs'); for (const path of ['node_modules', 'build', '.docusaurus', '.wrangler']) fs.rmSync(path, {recursive: true, force: true});\"",
    "clear": "docusaurus clear",
    "crowdin:check": "crowdin config lint && crowdin status",
    "crowdin:sync": "docusaurus write-translations && crowdin upload && crowdin download",
    "crowdin:upload": "crowdin upload sources --delete-obsolete",
    "export:llms": "node scripts/llms/export.mjs",
    "lint": "trunk check",
    "lint:all": "trunk check --all",
    "lint:fix": "trunk check --fix",
    "lint:links": "trunk check --filter lychee",
    "lint:links:all": "trunk check --all --filter lychee",
    "lint:links:refresh": "trunk check --all --filter lychee --cache=false",
    "project-health": "pnpm lint && pnpm typecheck && pnpm wrangler:typecheck && pnpm test:image-size-security && pnpm audit && pnpm build:en",
    "serve": "docusaurus serve",
    "start": "docusaurus start",
    "start:cf": "wrangler pages dev build --remote",
    "swizzle": "docusaurus swizzle",
    "test:code-fences": "node --test scripts/validate-code-fences.test.mjs",
    "test:image-size-security": "node --test scripts/image-size-security.test.mjs",
    "test:llms": "node --test scripts/llms/corpus.test.mjs",
    "test:mermaid": "node --test scripts/validate-mermaid.test.mjs",
    "test:plugin-standard": "node --test scripts/validate-plugin-standard.test.mjs",
    "test:prism": "node --test scripts/z-shell-languages.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:code-fences": "pnpm test:code-fences && pnpm test:mermaid && pnpm test:prism && node scripts/validate-code-fences.mjs && node scripts/validate-mermaid.mjs",
    "validate:frontmatter": "node scripts/validate-frontmatter.mjs",
    "validate:llms": "pnpm test:llms && node scripts/llms/validate.mjs && node scripts/llms/evaluate.mjs",
    "validate:plugin-standard": "pnpm test:plugin-standard && node scripts/validate-plugin-standard.mjs",
    "wrangler:typecheck": "tsc -p functions/tsconfig.json",
    "wrangler:types": "wrangler types --path='./functions/worker-env.d.ts'",
    "wrangler:types:check": "pnpm wrangler:types && git diff --exit-code -- functions/worker-env.d.ts",
    "write-docs-version": "docusaurus docs:version",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/plugin-ideal-image": "3.10.2",
    "@docusaurus/plugin-pwa": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "asciinema-player": "3.17.0",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@crowdin/cli": "5.0.0",
    "@docusaurus/eslint-plugin": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-blog": "3.10.2",
    "@docusaurus/plugin-content-pages": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "image-size": "2.0.2",
    "jiti": "^2.6.1",
    "jsdom": "29.1.1",
    "mermaid": "11.17.2",
    "stylelint": "17.14.1",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "wrangler": "4.127.1",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=11 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
