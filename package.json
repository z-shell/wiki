{
  "name": "wiki",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "docusaurus build && pnpm export:llms && pnpm validate:llms",
    "build:en": "docusaurus build --locale en && pnpm export:llms && pnpm validate:llms",
    "clean": "pnpm exec rm -rf node_modules build .docusaurus .wrangler  pnpm-lock.yaml",
    "clear": "docusaurus clear",
    "crowdin:check": "crowdin lint && crowdin status",
    "crowdin:sync": "docusaurus write-translations && crowdin upload && crowdin download",
    "crowdin:upload": "pnpm crowdin upload sources --delete-obsolete",
    "deploy": "docusaurus deploy",
    "export:llms": "node scripts/llms/export.mjs",
    "preinstall": "npx only-allow pnpm",
    "lint": "trunk check",
    "lint:all": "trunk check --all",
    "lint:fix": "trunk check --fix",
    "lint:links": "trunk check --filter lychee",
    "lint:links:all": "trunk check --all --filter lychee",
    "lint:links:refresh": "trunk check --all --filter lychee --cache=false",
    "project-health": "pnpm lint && pnpm wrangler:typecheck && pnpm build:en",
    "serve": "docusaurus serve",
    "start": "docusaurus start",
    "start:cf": "wrangler pages dev build --remote",
    "swizzle": "docusaurus swizzle",
    "test:llms": "node --test scripts/llms/corpus.test.mjs",
    "test:plugin-standard": "node --test scripts/validate-plugin-standard.test.mjs",
    "validate:frontmatter": "node scripts/validate-frontmatter.mjs",
    "validate:llms": "pnpm test:llms && node scripts/llms/validate.mjs && node scripts/llms/evaluate.mjs",
    "validate:plugin-standard": "pnpm test:plugin-standard && node scripts/validate-plugin-standard.mjs",
    "wrangler:typecheck": "tsc -p functions/tsconfig.json",
    "wrangler:types": "wrangler types --path='./functions/worker-env.d.ts'",
    "write-docs-version": "docusaurus docs:version",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-ideal-image": "3.10.2",
    "@docusaurus/plugin-pwa": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "asciinema-player": "3.15.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "@crowdin/cli": "4.15.0",
    "@docusaurus/eslint-plugin": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.2.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ajv": "8.20.0",
    "cheerio": "1.2.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.7.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "stylelint": "17.14.1",
    "stylelint-color-format": "1.1.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.1",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
