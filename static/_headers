# Explicit origin policy; Cloudflare must not inject its permissive default.
/*
  Content-Signal: search=yes, ai-input=yes, ai-train=no

# Machine-readable discovery indexes
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/*/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Complete locale corpora
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/*/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Canonical per-page Markdown
/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Versioned corpus manifest
/ai/v1/manifest.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# Repository-owned crawler policy
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# CDN font binaries — fingerprinted, cache immutably
/cdn/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Robots-Tag: nosnippet, noindex

# CDN recordings — fingerprinted, cache immutably
/cdn/cast/*.cast
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Robots-Tag: nosnippet, noindex

# CDN stylesheets — not fingerprinted, allow revalidation
/cdn/*.css
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
  X-Robots-Tag: nosnippet, noindex

# CDN fonts stylesheets — cache aggressively
/cdn/fonts/*.css
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Robots-Tag: nosnippet, noindex

# Fingerprinted build assets — cache aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Robots-Tag: nosnippet, noindex

# Static images — cache aggressively
/img/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Robots-Tag: nosnippet, noindex

# Prevent *.pages.dev production URL from being indexed
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Prevent preview deployment URLs from being indexed
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
