{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["./worker-env.d.ts", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
